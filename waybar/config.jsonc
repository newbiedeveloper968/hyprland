{
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "hyprland/window"
  ],

  "modules-center" : ["group/center"],

  "group/center": {
      "orientation": "horizontal",
      "spacing": 20,
      "modules": [
          "tray",
          "hyprland/workspaces",
          "mpris"
      ]
  },

  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/powermode",
    "battery",
    "clock"
  ],
  "hyprland/window": {
    "format": "{}",
    "max-length": 70,
    "rewrite": {
      "": "_"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": { "*": 6 },
    "cursor" : true,
    "format-icons": {
        "active": "󰮯",
        "persistent": "",
        "empty": ""
     }
  },
  "clock": {
      "timezone": "Dhaka",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "format": "{:%I:%M %p}",
      "calendar": {
          "mode": "month",
          "format": {
              "months": "<b>{}</b>",
              "days": "<span color='#acb0d0'><b>{}</b></span>",
              "today": "<span color='#41a6b5'><b><u>{}</u></b></span>"
  	    }
      }
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "interval": 5
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "   {essid} {signalStrength}% ",
    "format-ethernet": "   {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-disconnected": "Not connected",
    "tooltip-format": "  {ifname} via {gwaddr}",
    "tooltip-format-wifi": "   {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "interval": 1,
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
        "headphone": "",
        "headset": "",
        "headphone-muted": "󰟎",
        "headset-muted": "󰟎",
        "default": ["", ""],
        "default-muted": "󰖁"
    },
    "on-click": "pavucontrol"
  },
  "mpris": {
      "format": "{title}",
      "tooltip-format" : "{album}",
      "format-paused": " {title}",
      "on-click": "playerctl play-pause",
      "on-scroll-up": "playerctl previous",
      "on-scroll-down": "playerctl next",
      "max-length": 45
  },
  "tray" : {
      "icon-size": 13,
      "spacing": 10,
      "cursor": true
  },

  "custom/powermode": {
      "exec": "~/.config/waybar/scripts/power-mode.sh",
      "interval": 5,
      "format": "⚡{}",
      "on-click": "~/.config/waybar/scripts/power-mode.sh cycle",
      "tooltip": true
  },

  "bluetooth": {
      "format": "{}",
      "format-on": "󰂰 ",
      "format-off": "󰂲",
      "format-disabled" : "󰂲",
      "format-connected" : "{device_enumerate}   {device_battery_percentage}%",
      "tooltip-format": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
      "tooltip-format-enumerate-connected-battery": "{device_alias}\t {device_battery_percentage}%"
  }
}
