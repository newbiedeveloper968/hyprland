{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/powerprofile",
  ],
  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "clock"
  ],

  "battery": {
    "format": " {capacity}%"
  },

  "bluetooth": {
    "format": " {status}   ",
    "format-disabled": " OFF    ",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "",
    "format-disconnected": "⛔",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },

  "clock": {
    "interval": 1,
    "format": "{:%I:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A | %d %b %Y}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-bluetooth": " {volume}",
    "format-muted": "",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "headphone": "",
      "hands-free": ""
    },
    "on-click": "pavucontrol"
  },

  "hyprland/window": {
    "format": ">> {}"
  },

  "custom/powerprofile": {
    "exec": "~/.config/waybar/scripts/powerprofile.sh",
    "interval": 10,
    "on-click": "~/.config/waybar/scripts/powerprofile.sh click",
    "return-type": "json",
    "tooltip": true
  }
}
