# ~/.config/mpv/mpv.conf

# --- Video quality ---
profile=gpu-hq
gpu-context=wayland
vo=gpu-next
scale=ewa_lanczossharp
cscale=ewa_lanczossharp
dscale=mitchell
interpolation
tscale=oversample
deband=yes

# --- Hardware decoding (auto if possible) ---
hwdec=auto-safe

# --- Audio ---
volume=70
audio-normalize-downmix=yes

# --- Subtitles ---
sub-font="Itim"
sub-font-size=36
sub-color="#ffffff"
sub-border-color="#000000"
sub-border-size=2
sub-shadow-offset=1
sub-shadow-color="#000000"
sub-bold=yes
sub-margin-y=50

# --- Appearance ---
osc=yes                # Modern on-screen controls
osc-style=slimbox      # clean minimal bar (slimbox, box, btm, or fade)
border=no              # no window border (perfect in Hyprland)
cursor-autohide=always
keep-open=yes
save-position-on-quit=yes

# --- Interface ---
osd-font="Itim"
osd-font-size=28
osd-color="#ffffff"
osd-border-color="#000000"
osd-border-size=1
osd-shadow-offset=1
osd-shadow-color="#000000"

# --- Misc ---
resume-playback=yes

